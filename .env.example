APP_NAME="DIGITRANS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_TIMEZONE=Asia/Makassar
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digitrans
DB_USERNAME=root
DB_PASSWORD=

# Basis data sekali-pakai untuk grup uji tests/Database/ (Task 3.1).
# Terpisah dari DB dev; dibuat otomatis oleh Tests\DatabaseTestCase.
DB_TEST_DATABASE=digitrans_test

# Akun Admin pertama (AdminAwalSeeder, Task 3.5). Ketiganya SENGAJA dibiarkan
# kosong di sini: tanpa SIM_ADMIN_PASSWORD seeder membangkitkan sandi acak dan
# mencetaknya sekali ke terminal, yang memang perilaku yang diinginkan saat
# pemasangan di server (rules.md 14b poin 3).
#
# SIM_ADMIN_WAJIB_GANTI default TRUE -- Admin pertama wajib mengganti sandi dan
# membuat username saat masuk pertama (poin 5). Menyetelnya false hanya sah di
# mesin pengembang, supaya akun telusur tidak terlempar ke /ganti-kata-sandi
# setiap kali basis data dibangun ulang. JANGAN diisi di server.
#
# SIM_ADMIN_EMAIL=admin@malakakab.go.id
# SIM_ADMIN_NAMA="ADMINISTRATOR SISTEM"
# SIM_ADMIN_USERNAME=admin
# SIM_ADMIN_PASSWORD=
# SIM_ADMIN_WAJIB_GANTI=true

# Pembatasan laju (Task 3.10, rules.md 14c). Default menyala; angka boleh
# disetel lapangan tanpa ganti kode. Halaman internal dihitung per akun,
# kanal publik per IP. phpunit.xml menyetel SIM_BATAS_LAJU=false untuk suite uji.
SIM_BATAS_LAJU=true
# SIM_BATAS_BACA_INTERNAL=120
# SIM_BATAS_TULIS_INTERNAL=40
# SIM_BATAS_BERKAS_BESAR=30
# SIM_BATAS_LACAK_PUBLIK=10
# SIM_BATAS_KIRIM_PENGADUAN=3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
